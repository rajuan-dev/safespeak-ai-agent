NODE_ENV=development
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
APP_NAME=SafeSpeak Backend
APP_VERSION=1.0.0
API_PREFIX=/api/v1

CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

MONGODB_URI=mongodb://localhost:27017/safespeak
MONGODB_DATABASE=
DATABASE_NAME=
MONGODB_DNS_SERVERS=

LOG_LEVEL=INFO
DEBUG_FULL_RESPONSE=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

JWT_ACCESS_SECRET=replace-with-a-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-a-32-character-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ASR_MAX_FILE_SIZE_BYTES=26214400

AI_RESPONSE_MODE=safespeak_model
AI_AGENT_INTERNAL_TOKEN=replace-with-a-long-shared-service-token
BACKEND_API_BASE_URL=http://127.0.0.1:8000/api/v1

RAG_VECTOR_PROVIDER=pinecone
RAG_VECTOR_INDEX=rag_chunks_vector_index
RAG_TOP_K_LEGAL=6
RAG_TOP_K_SUPPORT=5
RAG_MIN_SCORE_LEGAL=0.58
RAG_MIN_SCORE_SUPPORT=0.68
RAG_MAX_CHUNKS_PER_SOURCE=2
RAG_ENABLE_OCR=false
RAG_RERANK_PROVIDER=hybrid
RAG_RERANK_CANDIDATES=20
RAG_REQUIRE_COMPLETE_CITATIONS=true
RAG_MIN_CLAIM_SUPPORT_SCORE=0.18

PINECONE_API_KEY=
PINECONE_INDEX_NAME=safespeak-legislation-dev
PINECONE_NAMESPACE=dev
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
OCR_MIN_CONFIDENCE=0.85
OCR_MAX_PAGES=100
OCR_BATCH_SIZE=5
OCR_PAGE_TIMEOUT_MS=60000
OCR_JOB_TIMEOUT_MS=0
OCR_REVIEW_REQUIRED=true
TESSERACT_CMD=
TESSDATA_PATH=./tools/tessdata

LEGAL_REQUIRE_PRODUCTION_GOLDEN=true
LEGAL_FAIL_CLOSED_ON_STARTUP=true
LEGAL_GOLDEN_REPORT_PATH=./legal-golden/reports/latest.json

KNOWLEDGE_STORAGE_PATH=./storage/knowledge-sources
INTERNAL_KNOWLEDGE_DIR=knowledge/internal
ENABLE_INTERNAL_KNOWLEDGE_AUTO_APPROVE=true
MAX_UPLOAD_BYTES=52428800

EVIDENCE_LOCAL_STORAGE_PATH=./storage/evidence
EVIDENCE_ENCRYPTION_KEY=replace-with-a-32-byte-base64-or-hex-key
EVIDENCE_AUDIT_SIGNING_KEY=replace-with-a-32-byte-signing-key
EVIDENCE_MAX_FILE_SIZE_BYTES=10485760
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_PREFIX=evidence-vault

CONTENT_RESOURCE_STORAGE_PATH=./storage/content-resources
CONTENT_RESOURCE_MAX_FILE_SIZE_BYTES=52428800
MICRO_EDUCATION_IMAGE_STORAGE_PATH=./storage/microeducation-images
MICRO_EDUCATION_IMAGE_MAX_FILE_SIZE_BYTES=10485760
MICRO_EDUCATION_S3_BUCKET=
MICRO_EDUCATION_S3_PREFIX=microeducation-images
MICRO_EDUCATION_CDN_BASE_URL=
MEDIA_ASSET_STORAGE_PATH=./storage/media-assets
MEDIA_ASSET_MAX_FILE_SIZE_BYTES=2097152

AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

REPORT_DELIVERY_EXPORT_PATH=./storage/report-delivery
DELIVERY_API_TIMEOUT_MS=15000
DELIVERY_API_BEARER_TOKEN=
DELIVERY_MTLS_PROXY_URL=
DELIVERY_EMAIL_WEBHOOK_URL=
DELIVERY_EMAIL_WEBHOOK_TOKEN=

AUTH_RESET_EMAIL_WEBHOOK_URL=
AUTH_RESET_EMAIL_WEBHOOK_TOKEN=
AUTH_RESET_OUTBOX_PATH=./storage/auth-recovery

SCAMSHIELD_URLHAUS_AUTH_KEY=
SCAMSHIELD_SAFE_BROWSING_API_KEY=

ENABLE_ADMIN_SEED=false
DEFAULT_SUPER_ADMIN_EMAIL=
DEFAULT_SUPER_ADMIN_PASSWORD=
DEFAULT_SUPER_ADMIN_FULL_NAME=SafeSpeak Super Admin

# DATABASE_NAME is supported as a compatibility alias for MONGODB_DATABASE.
# Production secret rotation is required before deployment.
