APP_NAME=SafeSpeak AI Agent
APP_VERSION=0.1.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/safespeak
MONGODB_DATABASE=
JWT_ACCESS_SECRET=replace-with-the-same-secret-used-by-safespeak-backend

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

PINECONE_API_KEY=
PINECONE_INDEX_NAME=safespeak-legislation-dev
PINECONE_NAMESPACE=dev

RAG_TOP_K_LEGAL=6
RAG_MIN_SCORE_LEGAL=0.55
RAG_MAX_CHUNKS_PER_SOURCE=3
RAG_CHUNK_TARGET_CHARS=2400
RAG_CHUNK_MAX_CHARS=3600
RAG_ENABLE_OCR=false
OCR_LANGUAGE=eng
OCR_MIN_CONFIDENCE=0.85
OCR_REVIEW_REQUIRED=true
TESSERACT_CMD=
TESSDATA_PATH=./tools/tessdata
LEGAL_REQUIRE_PRODUCTION_GOLDEN=true
LEGAL_FAIL_CLOSED_ON_STARTUP=true
LEGAL_GOLDEN_REPORT_PATH=./legal-golden/reports/latest.json
RAG_RERANK_PROVIDER=hybrid
RAG_RERANK_CANDIDATES=20
RAG_REQUIRE_COMPLETE_CITATIONS=true
RAG_MIN_CLAIM_SUPPORT_SCORE=0.18
KNOWLEDGE_STORAGE_PATH=./storage/knowledge-sources
MAX_UPLOAD_BYTES=52428800

BACKEND_API_BASE_URL=http://localhost:5000/api/v1
